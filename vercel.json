{
  "framework": "vite",
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "excludeFiles": "{public/**,node_modules/**,backend/tests/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
